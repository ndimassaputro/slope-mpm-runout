{
    "problem_data": {
        "problem_name": "F1p58_Et025_toe_erosion",
        "parallel_type": "OpenMP",
        "echo_level": 0,
        "start_time": 1.0,
        "end_time": 1.2
    },
    "solver_settings": {
        "solver_type": "Dynamic",
        "model_part_name": "MPM_Material",
        "domain_size": 2,
        "echo_level": 1,
        "analysis_type": "non_linear",
        "model_import_settings": {
            "input_type": "rest",
            "input_filename": "MPM_Material",
